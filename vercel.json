{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/espnweb/:path*", "destination": "https://site.web.api.espn.com/:path*" },
    { "source": "/espncore/:path*", "destination": "https://sports.core.api.espn.com/:path*" },
    { "source": "/espn/:path*", "destination": "https://site.api.espn.com/:path*" },
    { "source": "/mlbstats/:path*", "destination": "https://statsapi.mlb.com/:path*" },
    { "source": "/nhlweb/:path*", "destination": "https://api-web.nhle.com/:path*" }
  ]
}
